# Test fixtures: real APKs are too big for git (GitHub rejects files over 100 MB).
# Keep them locally in Extra/APK; only the tiny launcher APK is tracked.
# Tests that need an absent fixture fail with "Fixture mancante".
Extra/APK/*
!Extra/APK/xbmc-launcher-3-4-3.apk
!Extra/APK/.gitkeep
