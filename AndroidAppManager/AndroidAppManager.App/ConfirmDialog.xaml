<Window x:Class="AndroidAppManager.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="580" SizeToContent="Height" MaxHeight="700" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Rail}" FontFamily="Segoe UI" FontSize="13"
        TextElement.Foreground="{StaticResource Text}">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ToneDot" Width="10" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
            <TextBlock x:Name="Heading" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold"
                       Margin="12,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox x:Name="BodyBox" Grid.Row="1" Margin="0,16,0,0" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="{StaticResource Night}" Padding="14,12" MaxHeight="440"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelBtn" IsCancel="True" Margin="0,0,10,0" Click="OnCancel"/>
            <Button x:Name="ConfirmBtn" Style="{StaticResource PrimaryBtn}" IsDefault="True" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
