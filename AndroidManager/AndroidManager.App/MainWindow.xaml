<Window x:Class="AndroidManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AndroidManager.App"
        Title="AndroidManager" Width="1360" Height="700" MinWidth="1180" MinHeight="600"
        Background="{StaticResource Night}" FontFamily="Segoe UI" FontSize="13"
        TextElement.Foreground="{StaticResource Text}"
        AllowDrop="True" DragEnter="OnDragEnter" DragLeave="OnDragLeave" DragOver="OnDragOver" Drop="OnDropFiles"
        Closing="OnWindowClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource Line}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: connected devices + how to connect them, and the event log at the bottom. -->
        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="20,22,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="AndroidManager" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,-8,0" Padding="0,0,8,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="ScanBtn" DockPanel.Dock="Right" Content="Aggiorna" Style="{StaticResource MiniBtn}" Click="OnScan"/>
                            <TextBlock Text="DISPOSITIVI CONNESSI" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource DeviceRow}" GroupName="Dev" Margin="0,0,0,8"
                                                 Tag="{Binding Serial}" IsEnabled="{Binding CanSelect}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnPickDevice">
                                        <StackPanel>
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Right" Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoDevices" Style="{StaticResource Hint}"
                                   Text="Nessun dispositivo. Collega un telefono via USB (debug USB attivo) o connettilo via Wi-Fi qui sotto."/>
                        <Button x:Name="DisconnectBtn" Content="Scollega (Wi-Fi)" Style="{StaticResource MiniBtn}" Margin="0,2,0,0"
                                HorizontalAlignment="Left" Visibility="Collapsed" Click="OnDisconnect"/>

                        <Rectangle Style="{StaticResource Sep}" Margin="0,18,0,0"/>
                        <TextBlock Text="CONNESSIONE WI-FI" Style="{StaticResource SectionLabel}" Margin="0,16,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Indirizzo IP" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="HostBox" Tag="192.168.1.x"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Porta" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="PortBox" Text="5555"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="ConnectBtn" Content="Connetti" Style="{StaticResource PrimaryBtn}" Margin="0,12,0,0" Click="OnConnect"/>

                        <ToggleButton x:Name="PairToggle" Style="{StaticResource GhostBtn}" Margin="-16,8,0,0"
                                      Content="Abbinamento (Android 11+)"/>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=PairToggle, Converter={StaticResource BoolToVis}}"
                                    Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Porta di abbinamento" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="PairPortBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Codice" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="PairCodeBox" MaxLength="8"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="PairBtn" Content="Abbina" Margin="0,10,0,0" Click="OnPair"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Event log, terminal style -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Svuota" Style="{StaticResource GhostBtn}" Padding="8,3" FontSize="12"
                                Margin="0,0,-8,0" Click="OnClearLog"/>
                        <TextBlock Text="REGISTRO EVENTI" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel x:Name="OpPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="OpText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="OpBar" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="LogBox" Style="{StaticResource TerminalStyle}" Height="220" IsReadOnly="True" Margin="0,8,0,0"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace: tabs act on the selected device. -->
        <Grid Grid.Column="1" Margin="28,22,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border HorizontalAlignment="Left" Background="{StaticResource Raised}" CornerRadius="10" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabDevice" Style="{StaticResource Seg}" Content="Dispositivo" GroupName="Tab"
                                 IsChecked="True" Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabApps" Style="{StaticResource Seg}" Content="App" GroupName="Tab" Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabFiles" Style="{StaticResource Seg}" Content="File" GroupName="Tab" Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabPhotos" Style="{StaticResource Seg}" Content="Foto" GroupName="Tab" Checked="OnTabChanged"/>
                </StackPanel>
            </Border>

            <Rectangle Grid.Row="1" Style="{StaticResource Sep}" Margin="0,18,0,0"/>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <local:DeviceView x:Name="DevicePage"/>
                <local:AppsView x:Name="AppsPage" Visibility="Collapsed"/>
                <local:FilesView x:Name="FilesPage" Visibility="Collapsed"/>
                <local:PhotosView x:Name="PhotosPage" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
