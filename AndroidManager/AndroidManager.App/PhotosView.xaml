<UserControl x:Class="AndroidManager.App.PhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,12,0">

            <!-- 1. Route: who sends to whom -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="PERCORSO" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sorgente (dispositivo selezionato)" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="SourceName" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource Icons}" FontSize="22"
                                   Foreground="{StaticResource Accent}" Margin="22,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Destinazione (backup)" Style="{StaticResource Hint}"/>
                            <Border Background="{StaticResource Raised}" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <WrapPanel x:Name="DestPanel"/>
                            </Border>
                            <TextBlock x:Name="DestHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="RouteHint" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. What to move -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="ReadFoldersBtn" DockPanel.Dock="Right" Content="Leggi cartelle" Click="OnReadFolders"/>
                        <TextBlock Text="Cartelle da trasferire" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="FolderHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Premi Leggi cartelle per vedere cosa c'è sul sorgente."/>
                    <ItemsControl x:Name="FolderList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{StaticResource Switch}"
                                              Content="{Binding Folder}" Click="OnFolderToggled"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Stats}" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. How, and go -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <CheckBox x:Name="DeleteBox" Style="{StaticResource Switch}" Content="Cancella dal sorgente dopo la verifica"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="46,6,0,0"
                               Text="Cancello solo i file che ritrovo sul backup con la stessa dimensione. Se qualcosa non torna, il file resta sul sorgente."/>
                    <DockPanel Margin="0,16,0,0" LastChildFill="False">
                        <Button x:Name="StartBtn" DockPanel.Dock="Right" Content="Avvia trasferimento" Style="{StaticResource PrimaryBtn}"
                                Margin="10,0,0,0" Click="OnStart"/>
                        <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Annulla" Visibility="Collapsed"
                                Margin="10,0,0,0" Click="OnCancel"/>
                        <Button x:Name="AnalyzeBtn" DockPanel.Dock="Right" Content="Analizza" Click="OnAnalyze"
                                ToolTip="Confronta le cartelle scelte con il backup senza copiare nulla."/>
                        <TextBlock x:Name="PlanText" DockPanel.Dock="Left" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 4. Progress and result -->
            <Border x:Name="RunCard" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="AVANZAMENTO" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Step0" Text="Copia"/>
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Slate}" Margin="12,2"/>
                        <TextBlock x:Name="Step1" Text="Verifica sul backup"/>
                        <TextBlock x:Name="StepArrow" Text="&#xE76C;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Slate}" Margin="12,2"/>
                        <TextBlock x:Name="Step2" Text="Cancellazione dal sorgente"/>
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Slate}" Margin="12,2"/>
                        <TextBlock x:Name="Step3" Text="Galleria del backup"/>
                    </StackPanel>
                    <ProgressBar x:Name="RunBar" Minimum="0" Maximum="1" Height="8" Margin="0,14,0,0"/>
                    <TextBlock x:Name="RunText" Style="{StaticResource Hint}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ResultDot" Width="10" Height="10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ResultTitle" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ResultText" Margin="20,6,0,0" TextWrapping="Wrap"/>
                        <TextBox x:Name="ProblemsBox" Style="{StaticResource LogBoxStyle}" Height="120" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
