<UserControl x:Class="AndroidManager.App.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,12,0">

            <TextBlock x:Name="ActiveText" Style="{StaticResource Hint}" FontSize="13"/>

            <!-- Device to PC -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Copia una cartella sul PC" Style="{StaticResource CardTitle}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12"
                               Text="Copia tutto il contenuto, sottocartelle comprese, in una cartella vuota del PC. Non cancella nulla dal dispositivo."/>
                    <DockPanel>
                        <Button x:Name="CopyBtn" DockPanel.Dock="Right" Content="Scegli destinazione e copia..."
                                Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0" Click="OnCopyToPc"/>
                        <TextBox x:Name="FolderBox" Tag="Cartella sul dispositivo, es. DCIM/Camera" Text="DCIM/Camera"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="DCIM/Camera" Tag="DCIM/Camera" Style="{StaticResource GhostBtn}" Padding="10,4" FontSize="12" Click="OnQuickFolder"/>
                        <Button Content="Pictures" Tag="Pictures" Style="{StaticResource GhostBtn}" Padding="10,4" FontSize="12" Click="OnQuickFolder"/>
                        <Button Content="Download" Tag="Download" Style="{StaticResource GhostBtn}" Padding="10,4" FontSize="12" Click="OnQuickFolder"/>
                        <Button Content="Documents" Tag="Documents" Style="{StaticResource GhostBtn}" Padding="10,4" FontSize="12" Click="OnQuickFolder"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- PC to device -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Invia file al dispositivo" Style="{StaticResource CardTitle}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12"
                               Text="Puoi anche trascinare i file nella finestra. Un file con lo stesso nome già presente non viene sovrascritto."/>
                    <DockPanel>
                        <Button x:Name="PushBtn" DockPanel.Dock="Right" Content="Scegli file..." Style="{StaticResource PrimaryBtn}"
                                Margin="12,0,0,0" Click="OnPushFiles"/>
                        <TextBox x:Name="TargetBox" Tag="Cartella di destinazione" Text="Documents"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
